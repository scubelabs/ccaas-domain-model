{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scubelabs.dev/schemas/ccaas-event-envelope.schema.json",
  "title": "Canonical CCaaS Domain Event Envelope",
  "type": "object",
  "required": ["event_id","event_type","event_version","occurred_at","tenant_id","correlation_id","producer","data"],
  "properties": {
    "event_id": {"type":"string","minLength":1},
    "event_type": {"type":"string","pattern":"^[a-z0-9_]+(\\.[a-z0-9_]+)+$"},
    "event_version": {"type":"integer","minimum":1},
    "occurred_at": {"type":"string","format":"date-time"},
    "tenant_id": {"type":"string","minLength":1},
    "interaction_id": {"type":["string","null"]},
    "aggregate_id": {"type":["string","null"]},
    "aggregate_version": {"type":["integer","null"],"minimum":1},
    "correlation_id": {"type":"string","minLength":1},
    "causation_id": {"type":["string","null"]},
    "producer": {"type":"string","minLength":1},
    "data_classification": {"type":["string","null"]},
    "data": {"type":"object"}
  },
  "additionalProperties": false
}
